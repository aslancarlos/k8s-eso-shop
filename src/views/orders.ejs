<%- include('partials/head', { title: t('orders.title') }) %>

<header class="page-header">
  <h1 class="page-title"><%= t('orders.title') %></h1>
  <p class="page-subtitle"><%= t('orders.subtitle') %></p>
</header>

<% if (error) { %>
  <%- include('partials/alert', { label: t('common.db_error'), message: error }) %>
<% } %>

<% if (orders.length === 0 && !error) { %>
  <div class="card empty-state"><%= t('orders.empty') %></div>
<% } else if (orders.length) { %>
  <div class="card card--table">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col"><%= t('orders.col_customer') %></th>
            <th scope="col"><%= t('orders.col_email') %></th>
            <th scope="col" class="num-col"><%= t('orders.col_items') %></th>
            <th scope="col" class="num-col"><%= t('orders.col_total') %></th>
            <th scope="col"><%= t('orders.col_status') %></th>
            <th scope="col"><%= t('orders.col_date') %></th>
            <th scope="col"><span class="sr-only"><%= t('orders.view') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td class="mono muted">#<%= o.id %></td>
              <td class="strong"><%= o.customer_name %></td>
              <td class="muted"><%= o.customer_email %></td>
              <td class="num-col num"><%= o.item_count %></td>
              <td class="num-col num strong">$<%= parseFloat(o.total).toFixed(2) %></td>
              <td><%- include('partials/status-chip', { status: o.status }) %></td>
              <td class="muted num"><%= new Date(o.created_at).toLocaleDateString(lang) %></td>
              <td class="text-right"><a href="orders/<%= o.id %>" class="link"><%= t('orders.view') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('partials/foot') %>
