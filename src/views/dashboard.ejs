<%- include('partials/head', { title: 'Dashboard' }) %>

<div class="dash-header">
  <div>
    <h1 class="page-title">Live Dashboard</h1>
    <p class="page-subtitle">Auto-refresh a cada 5s · <span id="last-update">—</span></p>
  </div>
  <div class="dash-overall" id="overall-badge">
    <span class="overall-dot" id="overall-dot"></span>
    <span id="overall-text">Carregando…</span>
  </div>
</div>

<!-- Métricas de topo -->
<div class="metric-row" id="metric-row">
  <div class="metric-card">
    <div class="metric-label">Pods Running</div>
    <div class="metric-value" id="m-ready">—</div>
    <div class="metric-sub" id="m-desired">de — desejados</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">DB Connection</div>
    <div class="metric-value" id="m-db">—</div>
    <div class="metric-sub">myappDB · 54.207.103.247</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Secret Revision</div>
    <div class="metric-value metric-value--sm" id="m-rv">—</div>
    <div class="metric-sub" id="m-secret">eso-shop-db-creds</div>
  </div>
  <div class="metric-card">
    <div class="metric-label">Operator</div>
    <div class="metric-value" id="m-op">—</div>
    <div class="metric-sub">eso-shop-operator</div>
  </div>
</div>

<!-- Pod grid -->
<div class="section">
  <div class="section-header">
    <h2 class="section-title">Pods</h2>
    <span class="section-badge" id="pod-count-badge">—</span>
  </div>
  <div class="pod-grid" id="pod-grid">
    <div class="pod-skeleton"></div>
    <div class="pod-skeleton"></div>
    <div class="pod-skeleton"></div>
  </div>
</div>

<!-- Evento de rotação -->
<div class="section">
  <div class="section-header">
    <h2 class="section-title">Histórico de Restarts</h2>
    <span class="section-hint">disparados pelo operador ao detectar atualização do secret</span>
  </div>
  <div id="events-list" class="events-list">
    <div class="event-empty">Nenhum restart registrado nesta sessão do operador.</div>
  </div>
</div>

<script>
const BASE = '<%= locals.base || "" %>'

function fmt(sec) {
  if (sec === null || sec === undefined) return '—'
  if (sec < 60)   return `${sec}s`
  if (sec < 3600) return `${Math.floor(sec/60)}m ${sec%60}s`
  return `${Math.floor(sec/3600)}h ${Math.floor((sec%3600)/60)}m`
}

function phaseClass(phase, ready) {
  if (ready && phase === 'Running') return 'pod--running'
  if (phase === 'Pending')          return 'pod--pending'
  if (phase === 'Terminating')      return 'pod--terminating'
  return 'pod--error'
}

function renderPods(pods) {
  const grid = document.getElementById('pod-grid')
  if (!pods || !pods.length) {
    grid.innerHTML = '<div class="event-empty">Nenhum pod encontrado.</div>'
    return
  }
  grid.innerHTML = pods.map(p => `
    <div class="pod-card ${phaseClass(p.phase, p.ready)}">
      <div class="pod-status-dot"></div>
      <div class="pod-info">
        <div class="pod-name" title="${p.name}">${p.name.split('-').slice(-2).join('-')}</div>
        <div class="pod-full-name">${p.name}</div>
        <div class="pod-meta">
          <span class="pod-phase">${p.phase}</span>
          <span class="pod-age">${fmt(p.age)}</span>
          ${p.restarts > 0 ? `<span class="pod-restarts">↺ ${p.restarts}</span>` : ''}
        </div>
        <div class="pod-node">${p.node || '—'}</div>
      </div>
    </div>
  `).join('')
}

function renderEvents(events) {
  const el = document.getElementById('events-list')
  if (!events || !events.length) {
    el.innerHTML = '<div class="event-empty">Nenhum restart registrado nesta sessão do operador.</div>'
    return
  }
  el.innerHTML = events.map((e, i) => `
    <div class="event-row ${i === 0 ? 'event-row--latest' : ''}">
      <div class="event-icon">↻</div>
      <div class="event-body">
        <div class="event-title">Rolling restart disparado</div>
        <div class="event-meta">
          <span class="event-ts">${e.ts}</span>
          <span class="event-rv">secret rv: ${e.secretRevision || '—'}</span>
        </div>
      </div>
      ${i === 0 ? '<span class="event-new">novo</span>' : ''}
    </div>
  `).join('')
}

async function refresh() {
  try {
    const r = await fetch(BASE + '/api/dashboard')
    if (!r.ok) throw new Error(`HTTP ${r.status}`)
    const d = await r.json()

    // timestamp
    const ts = new Date().toLocaleTimeString()
    document.getElementById('last-update').textContent = ts

    // overall
    const allOk = d.deployment && d.deployment.ready >= d.deployment.desired && d.dbConnected
    document.getElementById('overall-dot').className =
      'overall-dot ' + (allOk ? 'overall-dot--ok' : 'overall-dot--warn')
    document.getElementById('overall-text').textContent =
      allOk ? 'Tudo OK' : 'Atenção'

    // nav dot
    const nd = document.getElementById('nav-health-dot')
    if (nd) nd.className = 'dash-dot ' + (allOk ? 'dash-dot--ok' : 'dash-dot--warn')

    // metrics
    if (d.deployment) {
      document.getElementById('m-ready').textContent   = d.deployment.ready ?? '—'
      document.getElementById('m-desired').textContent = `de ${d.deployment.desired} desejados`
    }
    document.getElementById('m-db').textContent  = d.dbConnected ? '✓' : '✗'
    document.getElementById('m-db').className    =
      'metric-value ' + (d.dbConnected ? 'metric-value--ok' : 'metric-value--err')

    document.getElementById('m-rv').textContent  = (d.secretRevision || '—').slice(-8)
    document.getElementById('m-op').textContent  = d.operatorHealthy ? '✓' : '✗'
    document.getElementById('m-op').className    =
      'metric-value ' + (d.operatorHealthy ? 'metric-value--ok' : 'metric-value--err')

    const count = d.pods ? d.pods.length : 0
    document.getElementById('pod-count-badge').textContent = count + ' pod' + (count !== 1 ? 's' : '')

    renderPods(d.pods || [])
    renderEvents(d.events || [])

  } catch(e) {
    document.getElementById('overall-text').textContent = 'Erro: ' + e.message
  }
}

refresh()
setInterval(refresh, 5000)
</script>

<%- include('partials/foot') %>
