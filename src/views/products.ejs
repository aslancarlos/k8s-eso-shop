<%- include('partials/head', { title: t('products.title') }) %>

<header class="page-header">
  <h1 class="page-title"><%= t('products.title') %></h1>
  <p class="page-subtitle"><%= t('products.subtitle') %></p>
</header>

<nav class="filters" aria-label="<%= t('products.filter_label') %>">
  <a href="products" class="chip chip--filter"<% if (!activeCategory) { %> aria-current="page"<% } %>>
    <svg class="chip-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    <%= t('products.all') %>
  </a>
  <% categories.forEach(cat => { %>
    <a href="products?category=<%= encodeURIComponent(cat) %>" class="chip chip--filter"<% if (activeCategory === cat) { %> aria-current="page"<% } %>>
      <svg class="chip-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <%= cat %>
    </a>
  <% }) %>
  <span class="filters-count" aria-live="polite"><%= t('products.results', { n: products.length }) %></span>
</nav>

<% if (error) { %>
  <%- include('partials/alert', { label: t('common.db_error'), message: error }) %>
<% } %>

<div class="product-grid">
  <% products.forEach(p => { %>
    <%- include('partials/product-card', { p }) %>
  <% }) %>
</div>

<%- include('partials/foot') %>
