<%- include('partials/head', { title: order ? t('order_detail.title', { id: order.id }) : t('order_detail.fallback_title') }) %>

<header class="page-header">
  <a href="orders" class="back-link"><%= t('order_detail.back') %></a>
  <% if (order) { %>
    <h1 class="page-title"><%= t('order_detail.title', { id: order.id }) %></h1>
  <% } else { %>
    <h1 class="page-title"><%= t('order_detail.fallback_title') %></h1>
  <% } %>
</header>

<% if (error) { %>
  <%- include('partials/alert', { label: t('order_detail.error'), message: error }) %>
<% } %>

<% if (order) { %>
  <div class="order-detail-grid">
    <section class="card" aria-labelledby="od-customer">
      <h2 class="card-title" id="od-customer"><%= t('order_detail.customer') %></h2>
      <p class="strong"><%= order.customer_name %></p>
      <p class="muted"><%= order.customer_email %></p>
      <dl class="meta-list">
        <div><dt><%= t('order_detail.status') %></dt><dd><%- include('partials/status-chip', { status: order.status }) %></dd></div>
        <div><dt><%= t('orders.col_date') %></dt><dd class="num"><%= new Date(order.created_at).toLocaleString(lang) %></dd></div>
      </dl>
    </section>

    <section class="card card--table" aria-labelledby="od-items">
      <h2 class="card-title card-title--pad" id="od-items"><%= t('order_detail.items') %></h2>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col"><%= t('order_detail.col_product') %></th>
              <th scope="col" class="num-col"><%= t('order_detail.col_qty') %></th>
              <th scope="col" class="num-col"><%= t('order_detail.col_unit') %></th>
              <th scope="col" class="num-col"><%= t('order_detail.col_subtotal') %></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td>
                  <div class="item-name-cell">
                    <img src="<%= item.image_url %>" class="item-thumb" alt="" width="40" height="40" loading="lazy" />
                    <div>
                      <div class="strong"><%= item.name %></div>
                      <div class="muted text-sm"><%= item.category %></div>
                    </div>
                  </div>
                </td>
                <td class="num-col num"><%= item.quantity %></td>
                <td class="num-col num">$<%= parseFloat(item.unit_price).toFixed(2) %></td>
                <td class="num-col num">$<%= (item.quantity * item.unit_price).toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3" class="text-right"><%= t('order_detail.total') %></th>
              <td class="num-col num strong">$<%= parseFloat(order.total).toFixed(2) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  </div>
<% } %>

<%- include('partials/foot') %>
