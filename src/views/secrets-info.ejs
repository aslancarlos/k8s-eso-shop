<%- include('partials/head', { title: t('secrets_info.title') }) %>

<header class="page-header">
  <h1 class="page-title"><%= t('secrets_info.title') %></h1>
  <p class="page-subtitle"><%= t('secrets_info.subtitle') %></p>
</header>

<div class="secrets-grid">

  <section class="card card--flow guided" id="guided" aria-labelledby="guided-title">
    <div class="guided-head">
      <div>
        <h2 class="card-title card-title--tight" id="guided-title"><%= t('secrets_info.chain_title') %></h2>
        <p class="guided-hint"><%= t('secrets_info.guided_hint') %></p>
      </div>
      <div class="guided-controls">
        <button type="button" class="gbtn" id="gPrev" aria-label="<%= t('secrets_info.b_prev') %>" title="<%= t('secrets_info.b_prev') %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="gbtn gbtn--play" id="gPlay" aria-pressed="true" data-play="<%= t('secrets_info.b_play') %>" data-pause="<%= t('secrets_info.b_pause') %>">
          <svg class="ic-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
          <svg class="ic-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <span class="gplay-label" id="gPlayLabel"><%= t('secrets_info.b_pause') %></span>
        </button>
        <button type="button" class="gbtn" id="gNext" aria-label="<%= t('secrets_info.b_next') %>" title="<%= t('secrets_info.b_next') %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <span class="guided-count" aria-live="polite"><b id="gCur">1</b> / 5</span>
      </div>
    </div>

    <!-- Animated flow diagram: packet travels the active edge -->
    <div class="flow-diagram" id="flowDiagram" role="img" aria-label="<%= t('secrets_info.chain_title') %>">
      <div class="fnode fnode--conjur" data-node="0">
        <span class="fnode-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V5z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <span class="fnode-t"><%= t('secrets_info.node_conjur') %></span>
        <span class="fnode-s"><%= t('secrets_info.nsub_conjur') %></span>
      </div>
      <div class="fedge" data-edge="0"><span class="packet"></span></div>
      <div class="fnode fnode--eso" data-node="1">
        <span class="fnode-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.5 9a9 9 0 0 1 14.9-3.4L23 10M1 14l4.6 4.4A9 9 0 0 0 20.5 15"/></svg></span>
        <span class="fnode-t"><%= t('secrets_info.node_eso') %></span>
        <span class="fnode-s"><%= t('secrets_info.nsub_eso') %></span>
      </div>
      <div class="fedge" data-edge="1"><span class="packet"></span></div>
      <div class="fnode fnode--secret" data-node="2">
        <span class="fnode-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4l2 2M18 5l2 2M15 8l2 2"/></svg></span>
        <span class="fnode-t"><%= t('secrets_info.node_secret') %></span>
        <span class="fnode-s"><%= t('secrets_info.nsub_secret') %></span>
      </div>
      <div class="fedge" data-edge="2"><span class="packet"></span></div>
      <div class="fnode fnode--deploy" data-node="3">
        <span class="fnode-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/></svg></span>
        <span class="fnode-t"><%= t('secrets_info.node_deploy') %></span>
        <span class="fnode-s"><%= t('secrets_info.nsub_deploy') %></span>
      </div>
      <div class="fedge" data-edge="3"><span class="packet"></span></div>
      <div class="fnode fnode--app" data-node="4">
        <span class="fnode-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></span>
        <span class="fnode-t"><%= t('secrets_info.node_app') %></span>
        <span class="fnode-s"><%= t('secrets_info.nsub_app') %></span>
      </div>
    </div>

    <div class="guided-dots" id="gDots">
      <% [0,1,2,3,4].forEach(function (i) { %>
        <button type="button" class="gdot" data-go="<%= i %>" aria-label="<%= t('secrets_info.step_label', { n: i + 1 }) %>"></button>
      <% }) %>
    </div>

    <!-- Explanation panels, one visible at a time -->
    <div class="guided-panels">
      <div class="gpanel" data-step="0">
        <span class="gpanel-num">1</span>
        <div class="gpanel-body">
          <div class="gpanel-text"><%- t('secrets_info.step1') %></div>
          <pre class="code-block"><span class="c-k">auth</span>:
  <span class="c-k">jwt</span>:
    <span class="c-k">account</span>: conjur
    <span class="c-k">serviceID</span>: <span class="c-v">eks-latam</span>
    <span class="c-k">serviceAccountRef</span>: springboot-app  <span class="c-c"># pod SA JWT</span></pre>
        </div>
      </div>
      <div class="gpanel" data-step="1">
        <span class="gpanel-num">2</span>
        <div class="gpanel-body">
          <div class="gpanel-text"><%- t('secrets_info.step2') %></div>
          <pre class="code-block">data/vault/dev-demo-aslan/dbuser_dual/username  <span class="c-a">→</span> <span class="c-v">DB_USER</span>
data/vault/dev-demo-aslan/dbuser_dual/password  <span class="c-a">→</span> <span class="c-v">DB_PASS</span>
data/vault/dev-demo-aslan/dbuser_dual/address   <span class="c-a">→</span> <span class="c-v">DB_HOST</span></pre>
        </div>
      </div>
      <div class="gpanel" data-step="2">
        <span class="gpanel-num">3</span>
        <div class="gpanel-body">
          <div class="gpanel-text"><%- t('secrets_info.step3') %></div>
          <pre class="code-block"><span class="c-k">kind</span>: Secret
<span class="c-k">metadata</span>:
  <span class="c-k">name</span>: <span class="c-v">eso-shop-db-creds</span>
<span class="c-k">data</span>: { DB_USER, DB_PASS, DB_HOST }  <span class="c-c"># base64 · refresh 1m</span></pre>
        </div>
      </div>
      <div class="gpanel" data-step="3">
        <span class="gpanel-num">4</span>
        <div class="gpanel-body">
          <div class="gpanel-text"><%- t('secrets_info.step4') %></div>
          <pre class="code-block"><span class="c-k">envFrom</span>:
  - <span class="c-k">secretRef</span>:
      <span class="c-k">name</span>: <span class="c-v">eso-shop-db-creds</span></pre>
        </div>
      </div>
      <div class="gpanel" data-step="4">
        <span class="gpanel-num">5</span>
        <div class="gpanel-body">
          <div class="gpanel-text"><%- t('secrets_info.step5') %></div>
          <pre class="code-block"><span class="c-k">const</span> pool = mysql.createPool({
  <span class="c-k">host</span>: process.env.<span class="c-v">DB_HOST</span>,
  <span class="c-k">user</span>: process.env.<span class="c-v">DB_USER</span>,
  <span class="c-k">password</span>: process.env.<span class="c-v">DB_PASS</span>,
})  <span class="c-c">// no Conjur SDK</span></pre>
        </div>
      </div>
    </div>
  </section>

  <div class="card card--status">
    <h2 class="card-title"><%= t('secrets_info.live_status') %></h2>
    <div class="status-row">
      <span class="status-label"><%= t('secrets_info.db_label') %></span>
      <% if (dbConnected) { %>
        <span class="chip chip-success"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><%= t('secrets_info.connected') %></span>
      <% } else { %>
        <span class="chip chip-danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg><%= t('secrets_info.error_pill') %></span>
      <% } %>
    </div>
    <% if (dbConnected) { %>
      <div class="status-row"><span class="status-label"><%= t('secrets_info.db_time') %></span><span class="num"><%= dbTime %></span></div>
    <% } %>
    <div class="status-row"><span class="status-label">DB_HOST</span><code><%= dbHost %></code></div>
    <div class="status-row"><span class="status-label">DB_USER</span><code><%= dbUser %></code></div>
    <div class="status-row"><span class="status-label">DB_PASS</span><code><%= dbPass %></code></div>
    <div class="status-row"><span class="status-label">DB_NAME</span><code><%= dbName %></code></div>
    <div class="status-row"><span class="status-label">K8s Secret</span><code><%= secretName %></code></div>
    <div class="status-row"><span class="status-label">Namespace</span><code><%= esoNamespace %></code></div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mt-2"><%- include('partials/alert', { label: t('secrets_info.error_pill') + ':', message: error }) %></div>
    <% } %>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ClusterSecretStore</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: conjur-store
spec:
  provider:
    conjur:
      url: https://latamlab.secretsmgr.cyberark.cloud
      auth:
        jwt:
          account: conjur
          serviceID: eks-latam
          serviceAccountRef:
            name: springboot-app
            namespace: conjur
            audiences: [conjur]</pre>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ExternalSecret</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: eso-shop-db-creds
  namespace: eso-shop
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: conjur-store
    kind: ClusterSecretStore
  data:
  - secretKey: DB_USER
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/username
  - secretKey: DB_PASS
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/password
  - secretKey: DB_HOST
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/address</pre>
  </div>

</div>

<script>
  (function () {
    var root = document.getElementById('guided');
    if (!root) return;
    var STEPS = 5;
    var NODE = [1, 1, 2, 3, 4];   // node that "lights up" per step
    var EDGE = [0, -1, 1, 2, 3];  // edge whose packet animates (-1 = none)
    var DWELL = 5200;

    var nodes  = Array.prototype.slice.call(root.querySelectorAll('.fnode'));
    var edges  = Array.prototype.slice.call(root.querySelectorAll('.fedge'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('.gpanel'));
    var dots   = Array.prototype.slice.call(root.querySelectorAll('.gdot'));
    var gCur = document.getElementById('gCur');
    var gPlay = document.getElementById('gPlay');
    var gPlayLabel = document.getElementById('gPlayLabel');
    var LBL = { play: gPlay.getAttribute('data-play'), pause: gPlay.getAttribute('data-pause') };

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cur = 0, playing = !reduce, timer = null;

    function render() {
      var active = NODE[cur];
      nodes.forEach(function (n, i) {
        n.classList.toggle('done', i < active);
        n.classList.toggle('active', i === active);
      });
      edges.forEach(function (e, i) {
        e.classList.toggle('lit', i < active);
        e.classList.toggle('flow', i === EDGE[cur]);
      });
      panels.forEach(function (p, i) { p.classList.toggle('active', i === cur); });
      dots.forEach(function (d, i) {
        d.classList.toggle('active', i === cur);
        if (i === cur) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current');
      });
      gCur.textContent = cur + 1;
    }
    function schedule() {
      clearTimeout(timer);
      if (playing) timer = setTimeout(function () { go(cur + 1, true); }, DWELL);
    }
    function go(i, keep) {
      cur = (i % STEPS + STEPS) % STEPS;
      render();
      if (!keep) restartAuto();
      else schedule();
    }
    function restartAuto() { schedule(); }
    function setPlaying(p) {
      playing = p;
      root.classList.toggle('is-playing', p);
      gPlayLabel.textContent = p ? LBL.pause : LBL.play;
      gPlay.setAttribute('aria-pressed', String(p));
      if (p) schedule(); else clearTimeout(timer);
    }

    document.getElementById('gPrev').addEventListener('click', function () { go(cur - 1); });
    document.getElementById('gNext').addEventListener('click', function () { go(cur + 1); });
    gPlay.addEventListener('click', function () { setPlaying(!playing); });
    dots.forEach(function (d) { d.addEventListener('click', function () { go(+d.getAttribute('data-go')); }); });
    nodes.forEach(function (n, i) {
      n.addEventListener('click', function () { var s = NODE.indexOf(i); go(s < 0 ? i : s); });
    });

    // Keyboard scoped to the player (DESIGN.md: never global listeners).
    // Space on a focused button keeps its native meaning (activates that button).
    root.addEventListener('keydown', function (e) {
      if (/^(INPUT|TEXTAREA|SELECT|BUTTON|A)$/.test((e.target || {}).tagName || '') && (e.key === ' ' || e.key === 'Enter')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      else if (e.key === ' ' || e.code === 'Space') { e.preventDefault(); setPlaying(!playing); }
    });

    // Pause when the card scrolls out of view; resume when back (unless user paused).
    var userPaused = reduce;
    gPlay.addEventListener('click', function () { userPaused = !playing ? false : true; });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (ents) {
        ents.forEach(function (en) {
          if (en.isIntersecting) { if (!userPaused) setPlaying(true); }
          else { clearTimeout(timer); }
        });
      }, { threshold: 0.25 }).observe(root);
    }

    render();
    setPlaying(playing);
  })();
</script>

<%- include('partials/foot') %>
