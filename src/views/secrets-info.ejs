<%- include('partials/head', { title: t('secrets_info.title') }) %>

<div class="page-header">
  <h1 class="page-title"><%= t('secrets_info.title') %></h1>
  <p class="page-subtitle"><%= t('secrets_info.subtitle') %></p>
</div>

<div class="secrets-grid">

  <div class="card card--flow">
    <h2 class="card-title"><%= t('secrets_info.chain_title') %></h2>
    <ol class="flow-list">
      <li>
        <div class="flow-step">
          <span class="flow-num">1</span>
          <div><%- t('secrets_info.step1') %></div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">2</span>
          <div>
            <%- t('secrets_info.step2') %>
            <pre class="code-block">data/vault/dev-demo-aslan/dbuser_dual/username  → DB_USER
data/vault/dev-demo-aslan/dbuser_dual/password  → DB_PASS
data/vault/dev-demo-aslan/dbuser_dual/address   → DB_HOST</pre>
          </div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">3</span>
          <div><%- t('secrets_info.step3') %></div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">4</span>
          <div><%- t('secrets_info.step4') %></div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">5</span>
          <div><%- t('secrets_info.step5') %></div>
        </div>
      </li>
    </ol>
  </div>

  <div class="card card--status">
    <h2 class="card-title"><%= t('secrets_info.live_status') %></h2>
    <div class="status-row">
      <span class="status-label"><%= t('secrets_info.db_label') %></span>
      <% if (dbConnected) { %>
        <span class="status-pill status-pill--ok"><%= t('secrets_info.connected') %></span>
      <% } else { %>
        <span class="status-pill status-pill--err"><%= t('secrets_info.error_pill') %></span>
      <% } %>
    </div>
    <% if (dbConnected) { %>
      <div class="status-row"><span class="status-label"><%= t('secrets_info.db_time') %></span><span><%= dbTime %></span></div>
    <% } %>
    <div class="status-row"><span class="status-label">DB_HOST</span><code><%= dbHost %></code></div>
    <div class="status-row"><span class="status-label">DB_USER</span><code><%= dbUser %></code></div>
    <div class="status-row"><span class="status-label">DB_PASS</span><code><%= dbPass %></code></div>
    <div class="status-row"><span class="status-label">DB_NAME</span><code><%= dbName %></code></div>
    <div class="status-row"><span class="status-label">K8s Secret</span><code><%= secretName %></code></div>
    <div class="status-row"><span class="status-label">Namespace</span><code><%= esoNamespace %></code></div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error mt-2"><strong><%= t('secrets_info.error_pill') %>:</strong> <%= error %></div>
    <% } %>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ClusterSecretStore</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: conjur-store
spec:
  provider:
    conjur:
      url: https://latamlab.secretsmgr.cyberark.cloud
      auth:
        jwt:
          account: conjur
          serviceID: eks-latam
          serviceAccountRef:
            name: springboot-app
            namespace: conjur
            audiences: [conjur]</pre>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ExternalSecret</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: eso-shop-db-creds
  namespace: eso-shop
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: conjur-store
    kind: ClusterSecretStore
  data:
  - secretKey: DB_USER
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/username
  - secretKey: DB_PASS
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/password
  - secretKey: DB_HOST
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/address</pre>
  </div>

</div>

<%- include('partials/foot') %>
