<%- include('partials/head', { title: 'Secrets Info' }) %>

<div class="page-header">
  <h1 class="page-title">How Secrets Flow</h1>
  <p class="page-subtitle">Zero credentials in code — delivered by ESO → Conjur at runtime</p>
</div>

<div class="secrets-grid">

  <div class="card card--flow">
    <h2 class="card-title">Secret delivery chain</h2>
    <ol class="flow-list">
      <li>
        <div class="flow-step">
          <span class="flow-num">1</span>
          <div>
            <strong>ClusterSecretStore</strong> — ESO authenticates with Conjur Cloud via <code>authn-jwt/eks-latam</code>
            using the pod's Kubernetes service account JWT
          </div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">2</span>
          <div>
            <strong>ExternalSecret</strong> maps Conjur paths to a K8s Secret:
            <pre class="code-block">data/vault/dev-demo-aslan/dbuser_dual/username  → DB_USER
data/vault/dev-demo-aslan/dbuser_dual/password  → DB_PASS
data/vault/dev-demo-aslan/dbuser_dual/address   → DB_HOST</pre>
          </div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">3</span>
          <div>
            <strong>K8s Secret</strong> <code>eso-shop-db-creds</code> is created/refreshed by ESO
          </div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">4</span>
          <div>
            <strong>Deployment</strong> mounts the secret as environment variables via <code>envFrom.secretRef</code>
          </div>
        </div>
      </li>
      <li>
        <div class="flow-step">
          <span class="flow-num">5</span>
          <div>
            <strong>App</strong> reads <code>DB_HOST</code>, <code>DB_USER</code>, <code>DB_PASS</code> from env — no Conjur SDK, no file reads
          </div>
        </div>
      </li>
    </ol>
  </div>

  <div class="card card--status">
    <h2 class="card-title">Live connection status</h2>
    <div class="status-row">
      <span class="status-label">Database</span>
      <% if (dbConnected) { %>
        <span class="status-pill status-pill--ok">Connected</span>
      <% } else { %>
        <span class="status-pill status-pill--err">Error</span>
      <% } %>
    </div>
    <% if (dbConnected) { %>
      <div class="status-row"><span class="status-label">DB time</span><span><%= dbTime %></span></div>
    <% } %>
    <div class="status-row"><span class="status-label">DB_HOST</span><code><%= dbHost %></code></div>
    <div class="status-row"><span class="status-label">DB_USER</span><code><%= dbUser %></code></div>
    <div class="status-row"><span class="status-label">DB_PASS</span><code><%= dbPass %></code></div>
    <div class="status-row"><span class="status-label">DB_NAME</span><code><%= dbName %></code></div>
    <div class="status-row"><span class="status-label">K8s Secret</span><code><%= secretName %></code></div>
    <div class="status-row"><span class="status-label">Namespace</span><code><%= esoNamespace %></code></div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error mt-2"><strong>Error:</strong> <%= error %></div>
    <% } %>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ClusterSecretStore</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: conjur-store
spec:
  provider:
    conjur:
      url: https://latamlab.secretsmgr.cyberark.cloud
      auth:
        jwt:
          account: conjur
          serviceID: eks-latam
          serviceAccountRef:
            name: eso-shop-sa
            namespace: eso-shop</pre>
  </div>

  <div class="card card--yaml">
    <h2 class="card-title">ExternalSecret</h2>
    <pre class="code-block">apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: eso-shop-db-creds
  namespace: eso-shop
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: conjur-store
    kind: ClusterSecretStore
  target:
    name: eso-shop-db-creds
  data:
  - secretKey: DB_USER
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/username
  - secretKey: DB_PASS
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/password
  - secretKey: DB_HOST
    remoteRef:
      key: data/vault/dev-demo-aslan/dbuser_dual/address</pre>
  </div>

</div>

<%- include('partials/foot') %>
