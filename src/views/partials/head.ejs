<!DOCTYPE html>
<html lang="<%= locals.lang || 'pt' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'ESO Shop' %> · k8s-eso-shop</title>
  <% if (locals.base) { %><base href="<%= base %>/" /><% } %>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="portal-bar">
    <nav class="portal-switcher" aria-label="Portal switcher">
      <a href="/" class="ps-link ps-link--portal">
        <svg class="ps-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l10 10-10 10L2 12z"></path></svg>
        Portal
      </a>
      <span class="ps-sep" aria-hidden="true"></span>
      <a href="/springboot/dashboard" class="ps-link">Spring Boot</a>
      <a href="/dotnet/usuarios" class="ps-link">.NET</a>
      <a href="/k8s-eso/" class="ps-link ps-link--active" aria-current="page">ESO Shop</a>
      <a href="/swa-s3" class="ps-link">SWA &rarr; S3</a>
      <a href="/controller" class="ps-link">Controller</a>
    </nav>
  </div>
  <nav class="navbar">
    <div class="nav-inner">
      <a href="./" class="nav-brand">
        <span class="brand-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </span>
        <span class="brand-text">ESO<span class="brand-accent">Shop</span></span>
      </a>
      <div class="nav-links">
        <a href="products" class="nav-link"><%= t('nav.products') %></a>
        <a href="orders" class="nav-link"><%= t('nav.orders') %></a>
        <a href="secrets-info" class="nav-link nav-link--secrets">
          <span class="secrets-dot"></span><%= t('nav.secrets_info') %>
        </a>
        <a href="dashboard" class="nav-link nav-link--dashboard">
          <span class="dash-dot" id="nav-health-dot"></span><%= t('nav.dashboard') %>
        </a>
        <div class="lang-switcher">
          <%
            var flags = {
              en: '<svg viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#fff"/><g fill="#B22234"><rect y="0" width="24" height="1.23"/><rect y="2.46" width="24" height="1.23"/><rect y="4.92" width="24" height="1.23"/><rect y="7.38" width="24" height="1.23"/><rect y="9.84" width="24" height="1.23"/><rect y="12.3" width="24" height="1.23"/><rect y="14.76" width="24" height="1.23"/></g><rect width="10" height="8.6" fill="#3C3B6E"/></svg>',
              pt: '<svg viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#009B3A"/><path d="M12 2 22 8 12 14 2 8Z" fill="#FEDF00"/><circle cx="12" cy="8" r="3.1" fill="#002776"/></svg>',
              es: '<svg viewBox="0 0 24 16" aria-hidden="true"><rect width="24" height="16" fill="#C60B1E"/><rect y="4" width="24" height="8" fill="#FFC400"/></svg>'
            };
          %>
          <% ['pt','en','es'].forEach(function(l) { %>
            <a href="?lang=<%= l %>"
               class="lang-btn<%= (locals.lang === l) ? ' lang-btn--active' : '' %>"
               aria-label="<%= l.toUpperCase() %>">
              <span class="lang-flag"><%- flags[l] %></span><%= l.toUpperCase() %>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  </nav>
  <main class="main-content">
