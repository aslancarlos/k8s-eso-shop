<%- include('partials/head', { title: t('home.featured') }) %>

<section class="hero-band" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="hero-eyebrow"><%= t('home.eyebrow') %></p>
    <h1 class="hero-title" id="hero-title"><%= t('home.title') %> <span class="idira-shimmer"><%= t('home.title_accent') %></span></h1>
    <p class="hero-subtitle"><%- t('home.subtitle') %></p>
    <div class="hero-actions">
      <a href="products" class="btn btn-primary"><%= t('home.cta_browse') %></a>
      <a href="secrets-info" class="btn btn-secondary btn-on-dark"><%= t('home.cta_how') %></a>
    </div>
  </div>
  <ol class="hero-diagram">
    <li class="diag-node diag-node--k8s"><%= t('home.diag_app') %></li>
    <li class="diag-arrow" aria-hidden="true"><%= t('home.diag_reads') %></li>
    <li class="diag-node diag-node--k8s"><%= t('home.diag_k8s') %></li>
    <li class="diag-arrow" aria-hidden="true"><%= t('home.diag_synced') %></li>
    <li class="diag-node diag-node--k8s"><%= t('home.diag_eso') %></li>
    <li class="diag-arrow" aria-hidden="true"><%= t('home.diag_jwt') %></li>
    <li class="diag-node diag-node--idira"><%= t('home.diag_conjur') %></li>
  </ol>
</section>

<section class="section" aria-labelledby="featured-title">
  <div class="section-header">
    <h2 class="section-title" id="featured-title"><%= t('home.featured') %></h2>
    <a href="products" class="link"><%= t('home.view_all') %></a>
  </div>
  <% if (error) { %>
    <%- include('partials/alert', { label: t('common.db_error'), message: error }) %>
  <% } %>
  <div class="product-grid">
    <% products.slice(0, 8).forEach(p => { %>
      <%- include('partials/product-card', { p }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/foot') %>
