<%- include('partials/head', { title: 'Home' }) %>

<section class="hero">
  <div class="hero-text">
    <div class="hero-eyebrow">PANW|IDIRA Conjur · External Secrets Operator · Kubernetes</div>
    <h1 class="hero-title">Zero-Trust <span class="accent">Ecommerce</span></h1>
    <p class="hero-subtitle">
      A live demo where every database credential is fetched dynamically from
      <strong>Conjur Cloud</strong> via the <strong>External Secrets Operator</strong> —
      no hardcoded passwords, no .env file, no secret baked in the image.
    </p>
    <div class="hero-actions">
      <a href="products" class="btn btn--primary">Browse Products</a>
      <a href="secrets-info" class="btn btn--outline">How it works →</a>
    </div>
  </div>
  <div class="hero-diagram">
    <div class="diag-node diag-node--app">App Pod</div>
    <div class="diag-arrow">↓ reads env vars</div>
    <div class="diag-node diag-node--k8s">K8s Secret</div>
    <div class="diag-arrow">↑ synced by</div>
    <div class="diag-node diag-node--eso">ESO Controller</div>
    <div class="diag-arrow">↓ JWT authn</div>
    <div class="diag-node diag-node--conjur">Conjur Cloud</div>
  </div>
</section>

<section class="section">
  <div class="section-header">
    <h2 class="section-title">Featured Products</h2>
    <a href="products" class="section-link">View all →</a>
  </div>
  <% if (error) { %>
    <div class="alert alert--error"><strong>DB Error:</strong> <%= error %></div>
  <% } %>
  <div class="product-grid">
    <% products.slice(0, 8).forEach(p => { %>
      <div class="product-card">
        <div class="product-img-wrap">
          <img src="<%= p.image_url %>" alt="<%= p.name %>" class="product-img" loading="lazy" />
          <span class="product-badge"><%= p.category %></span>
        </div>
        <div class="product-info">
          <h3 class="product-name"><%= p.name %></h3>
          <p class="product-desc"><%= p.description %></p>
          <div class="product-footer">
            <span class="product-price">$<%= parseFloat(p.price).toFixed(2) %></span>
            <span class="product-stock"><%= p.stock %> in stock</span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/foot') %>
