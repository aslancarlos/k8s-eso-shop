<%- include('partials/head', { title: t('home.featured') }) %>

<!-- ════════════════════════════════════════════════════════════
     IDIRA hero — deep navy + iridescent mesh + diagonal CTAs
     ════════════════════════════════════════════════════════════ -->
<section class="idira-hero">
  <div class="idira-hero-mesh" aria-hidden="true"></div>
  <div class="idira-hero-grid" aria-hidden="true"></div>

  <div class="idira-hero-inner">
    <div class="idira-eyebrow">
      <span class="idira-eyebrow-dot"></span>
      <%= t('home.eyebrow') %>
    </div>

    <h1 class="idira-headline">
      <%= t('home.title') %>
      <em class="idira-shimmer"><%= t('home.title_accent') %></em><span class="idira-headline-dot">.</span>
    </h1>

    <p class="idira-lede"><%- t('home.subtitle') %></p>

    <div class="idira-hero-actions">
      <a href="products" class="idira-cta idira-cta-primary">
        <%= t('home.cta_browse') %>
        <span class="idira-cta-arrow">→</span>
      </a>
      <a href="secrets-info" class="idira-cta idira-cta-on-deep">
        <%= t('home.cta_how') %>
        <span class="idira-cta-arrow">↗</span>
      </a>
    </div>

    <div class="idira-stat-strip">
      <div class="idira-stat">
        <div class="idira-stat-num">04 <span class="idira-stat-unit">workloads</span></div>
        <div class="idira-stat-label">Spring · .NET · Actions · ESO</div>
      </div>
      <div class="idira-stat">
        <div class="idira-stat-num">01 <span class="idira-stat-unit">secrets manager</span></div>
        <div class="idira-stat-label">latamlab.secretsmgr.idira.cloud</div>
      </div>
      <div class="idira-stat">
        <div class="idira-stat-num idira-stat-accent">00 <span class="idira-stat-unit">at rest</span></div>
        <div class="idira-stat-label">Secrets baked into images or repos</div>
      </div>
      <div class="idira-stat">
        <div class="idira-stat-num">JWT <span class="idira-stat-unit">auth</span></div>
        <div class="idira-stat-label">authn-jwt · federated trust</div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     Featured products — IDIRA card grid
     ════════════════════════════════════════════════════════════ -->
<section class="section">
  <div class="section-header">
    <h2 class="section-title"><%= t('home.featured') %></h2>
    <a href="products" class="section-link"><%= t('home.view_all') %></a>
  </div>
  <% if (error) { %>
    <div class="alert alert--error"><strong><%= t('common.db_error') %></strong> <%= error %></div>
  <% } %>
  <div class="product-grid">
    <% products.slice(0, 8).forEach(p => { %>
      <div class="product-card idira-card">
        <div class="product-img-wrap">
          <img src="<%= p.image_url %>" alt="<%= p.name %>" class="product-img" loading="lazy" />
          <span class="product-badge"><%= p.category %></span>
        </div>
        <div class="product-info">
          <h3 class="product-name"><%= p.name %></h3>
          <p class="product-desc"><%= p.description %></p>
          <div class="product-footer">
            <span class="product-price">$<%= parseFloat(p.price).toFixed(2) %></span>
            <span class="product-stock"><%= p.stock %> <%= t('products.in_stock') %></span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     IDIRA promise band — Zero hardcoded secrets
     ════════════════════════════════════════════════════════════ -->
<section class="idira-promise-section">
  <div class="idira-promise">
    <div class="idira-promise-inner">
      <p class="idira-promise-eyebrow">// The promise</p>
      <div class="idira-promise-zero" aria-label="Zero">0</div>
      <h3 class="idira-promise-claim">
        Static credentials in source, images, env vars or CI secrets.
        <mark>The app never knew the password changed. Users never knew either.</mark>
      </h3>
      <p class="idira-promise-detail">
        Secret rotation is invisible. IDIRA Secrets Manager rotates,
        External Secrets Operator syncs, the watcher operator rolls — and
        the e-commerce stays up. That is the point of moving credentials
        out of code and into a federated identity layer.
      </p>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
